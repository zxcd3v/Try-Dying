# Образец конфига. Скопируйте в config/audiomodem.env и правьте под свой
# стенд; секреты в этом проекте не нужны, но .env в Git не добавляем.
#
# Формат: КЛЮЧ=значение, одна пара на строку, «#» — комментарий.
# Приоритет: флаг командной строки > этот файл > встроенные значения.
# Порядок поиска файла: $AUDIOMODEM_CONFIG → config/audiomodem.env →
# config/example.env. Неизвестные ключи игнорируются с предупреждением.

# Профиль передачи данных: robust (максимальный шум) | medium (обычная
# аудитория) | fast (тишина, максимальная скорость).
MODE=robust

# Каталог спул-модема: демо на одной машине, блоки ходят файлами.
# Обе стороны должны указывать один и тот же каталог.
LINK_DIR=link

# Куда приёмник кладёт принятый файл (создаётся при необходимости).
OUTPUT_DIRECTORY=received

# Таймаут ожидания другой стороны, секунды.
TIMEOUT_S=120

# Устройства sounddevice для режима --audio: номер или подстрока имени
# (список — python -c "import sounddevice; print(sounddevice.query_devices())").
# Пусто — устройство системы по умолчанию.
IN_DEVICE=
OUT_DEVICE=
