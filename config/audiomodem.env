# Рабочий конфиг CLI: отсюда send.py и recv.py берут пути и значения по
# умолчанию. Флаги командной строки перекрывают всё, что написано здесь.
# Образец со всеми ключами и пояснениями — config/example.env.
#
# Другой файл конфига: переменная окружения AUDIOMODEM_CONFIG=путь.

# Профиль передачи данных: robust | medium | fast.
MODE=robust

# Каталог спул-модема (демо на одной машине, без звука). Общий для обеих
# сторон; относительные пути считаются от текущего каталога запуска.
LINK_DIR=link

# Куда приёмник кладёт принятый файл.
OUTPUT_DIRECTORY=received

# Сколько секунд ждать другую сторону, прежде чем сдаться.
TIMEOUT_S=120

# Устройства sounddevice для --audio: номер или подстрока имени.
# Пусто — устройство системы по умолчанию.
IN_DEVICE=
OUT_DEVICE=
